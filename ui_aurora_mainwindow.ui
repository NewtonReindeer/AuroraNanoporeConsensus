     <widget class="QProgressBar" name="progress">
      <property name="styleSheet">
       <string notr="true">QProgressBar {
    background-color: #10131c;
    border: 1px solid #394056;
    border-radius: 10px;
    text-align: center;
    color: white;
    font-weight: bold;
    min-height: 20px;
}

QProgressBar::chunk {
    border-radius: 9px;

    background: qlineargradient(
        x1: 0, y1: 0,
        x2: 1, y2: 0,
        stop: 0.00 #7c3aed,
        stop: 0.20 #ec4899,
        stop: 0.42 #22d3ee,
        stop: 0.65 #34d399,
        stop: 0.82 #38bdf8,
        stop: 1.00 #8b5cf6
    );
}</string>
